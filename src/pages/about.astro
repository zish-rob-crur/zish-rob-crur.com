---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

const title = 'About';
const description = 'A quiet profile for zishRobCrur.';

const principles = [
	'Quiet, not weak.',
	'Gentle, not pleasing.',
	'Evidence first. Feelings acknowledged.',
	'Few, but good relationships.',
	'Training and recovery.',
	'Long-term thinking.',
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<p class="eyebrow">Profile</p>
				<h1>Quiet by default.<br />Precise on purpose.</h1>
				<p class="lede">
					I like clear systems, durable tools, and work that does not need to perform itself at full
					volume. This site is where writing, software, and longer-term defaults meet.
				</p>
			</section>

			<section class="about-grid">
				<article class="panel">
					<p class="section-label">Short version</p>
					<p>
						I build software, keep notes, and refine personal tooling. I prefer environments that are
						bright but not harsh, sharp but not harmful, and quiet enough for thought to deepen instead
						of scatter.
					</p>
					<p>
						Some of that shows up in code. Some of it shows up in how I write. Most of it shows up in
						the defaults I keep around me.
					</p>
				</article>

				<article class="panel">
					<p class="section-label">Principles</p>
					<ul class="principles">
						{
							principles.map((item) => (
								<li>{item}</li>
							))
						}
					</ul>
				</article>

				<article class="panel">
					<p class="section-label">Where to look</p>
					<div class="links">
						<a href="/blog">Read the archive</a>
						<a href="mailto:me@zish-rob-crur.com">Email</a>
						<a href="https://github.com/zish-rob-crur" target="_blank" rel="noreferrer">GitHub</a>
						<a href="https://x.com/zDAKVp9Nh6k1wj" target="_blank" rel="noreferrer">X</a>
						<a href="/rss.xml">RSS</a>
					</div>
				</article>
			</section>
		</main>
		<Footer />
	</body>
</html>
<style>
	main {
		width: min(920px, calc(100% - 2rem));
		max-width: none;
		padding: 4rem 0 5rem;
	}
	.intro {
		display: grid;
		gap: 0.65rem;
		padding-bottom: 2.1rem;
	}
	.eyebrow,
	.section-label {
		margin: 0;
		font-size: 0.78rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: rgb(var(--gray));
	}
	h1 {
		margin: 0;
		font-size: clamp(2.45rem, 5vw, 3.9rem);
		line-height: 1.02;
	}
	.lede {
		margin: 0;
		max-width: 42rem;
		font-size: 1.12rem;
		line-height: 1.7;
	}
	.about-grid {
		display: grid;
		gap: 1.2rem;
	}
	.panel {
		padding: 1.55rem;
		border: 1px solid rgba(var(--border), 0.55);
		border-radius: 1.6rem;
		background:
			linear-gradient(180deg, rgba(var(--surface-elevated), 0.8), rgba(var(--surface-elevated), 0.56)),
			rgba(var(--surface), 0.56);
		box-shadow: var(--box-shadow);
	}
	.panel p:last-child {
		margin-bottom: 0;
	}
	.principles {
		display: grid;
		gap: 0.8rem;
		margin: 1rem 0 0;
		padding: 0;
		list-style: none;
	}
	.principles li {
		position: relative;
		padding-left: 1rem;
	}
	.principles li::before {
		content: "";
		position: absolute;
		left: 0;
		top: 0.72em;
		width: 0.34rem;
		height: 0.34rem;
		border-radius: 999px;
		background: var(--accent);
		transform: translateY(-50%);
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.9rem 1.2rem;
		margin-top: 1rem;
	}
	.links a {
		text-decoration: none;
	}
	@media (max-width: 560px) {
		main {
			width: calc(100% - 1.3rem);
			padding-top: 2.5rem;
		}
		h1 {
			font-size: 2.95rem;
		}
		.panel {
			padding: 1.2rem;
			border-radius: 1.2rem;
		}
	}
</style>
