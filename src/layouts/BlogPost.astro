---
import { Image } from 'astro:assets';
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

interface Props extends CollectionEntry<'blog'>['data'] {
	newerPost?: CollectionEntry<'blog'> | null;
	olderPost?: CollectionEntry<'blog'> | null;
	headings?: MarkdownHeading[];
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	newerPost = null,
	olderPost = null,
	headings = [],
} = Astro.props;

const tableOfContents = headings.filter(({ depth }) => depth >= 2 && depth <= 4);
const hasTableOfContents = tableOfContents.length > 0;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
		<style>
			main {
				width: min(860px, calc(100% - 2rem));
				max-width: none;
			}
			main.has-toc {
				width: min(1180px, calc(100% - 2rem));
			}
			.story {
				display: grid;
				gap: 2rem;
			}
			.article-body {
				display: grid;
				gap: 2rem;
			}
			.article-body.has-toc {
				grid-template-columns: minmax(0, 42rem) minmax(15rem, 18rem);
				align-items: start;
				justify-content: space-between;
				gap: 2.4rem;
			}
			.article-main {
				width: min(42rem, 100%);
			}
			.back-link,
			.adjacent-card {
				width: fit-content;
				text-decoration: none;
			}
			.back-link {
				font-size: 0.88rem;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: rgb(var(--gray));
			}
			.article-header {
				display: grid;
				gap: 0.85rem;
				padding-bottom: 1.8rem;
				border-bottom: 1px solid rgba(var(--border), 0.58);
			}
			.meta,
			.kicker {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.7rem;
				font-size: 0.9rem;
				color: rgb(var(--gray));
			}
			.kicker {
				letter-spacing: 0.14em;
				text-transform: uppercase;
				font-size: 0.78rem;
			}
			.title {
				margin: 0;
			}
			.title h1 {
				margin: 0;
				font-size: clamp(2.8rem, 7vw, 5rem);
				line-height: 0.98;
			}
			.deck {
				max-width: 42rem;
				margin: 0;
				font-size: 1.14rem;
				line-height: 1.8;
			}
			.hero-image img {
				display: block;
				width: 100%;
				border-radius: 20px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: min(42rem, 100%);
				max-width: none;
				margin: 0;
				padding: 0;
				color: rgb(var(--gray-dark));
			}
			:global(.prose > :first-child) {
				margin-top: 0;
			}
			:global(.prose > h1:first-child) {
				display: none;
			}
			:global(.prose h2),
			:global(.prose h3),
			:global(.prose h4) {
				margin-top: 2.1rem;
				margin-bottom: 0.7rem;
				scroll-margin-top: 6.5rem;
			}
			:global(.prose ul),
			:global(.prose ol) {
				padding-left: 1.35rem;
			}
			.table-of-contents {
				position: sticky;
				top: 6.5rem;
				display: grid;
				gap: 0.9rem;
				max-height: calc(100vh - 7.5rem);
				overflow: auto;
				padding: 1rem 1rem 1.15rem;
				border: 1px solid rgba(var(--border), 0.58);
				border-radius: 1.1rem;
				background: rgba(var(--surface-elevated), 0.6);
				backdrop-filter: blur(14px);
			}
			.toc-label {
				margin: 0;
				font-size: 0.78rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: rgb(var(--gray));
			}
			.toc-list {
				display: grid;
				gap: 0.2rem;
				margin: 0;
				padding: 0;
				list-style: none;
			}
			.toc-item {
				margin: 0;
				padding: 0;
			}
			.toc-item.depth-3 {
				padding-left: 0.85rem;
			}
			.toc-item.depth-4 {
				padding-left: 1.45rem;
			}
			.toc-link {
				display: block;
				padding: 0.42rem 0.55rem;
				border-radius: 0.8rem;
				color: rgb(var(--gray-dark));
				font-size: 0.96rem;
				line-height: 1.4;
				text-decoration: none;
				transition:
					background-color 180ms ease,
					color 180ms ease,
					transform 180ms ease;
			}
			.toc-link:hover,
			.toc-link:focus-visible,
			.toc-link.is-active {
				background: rgba(var(--gray-soft), 0.72);
				color: var(--accent);
				transform: translateX(2px);
			}
			.last-updated-on {
				font-style: italic;
			}
			.article-footer {
				display: grid;
				gap: 1rem;
				padding-top: 1.5rem;
				border-top: 1px solid rgba(var(--border), 0.58);
			}
			.adjacent-grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1rem;
			}
			.adjacent-card {
				display: grid;
				gap: 0.4rem;
				min-height: 7.4rem;
				padding: 1rem 1.1rem;
				border: 1px solid rgba(var(--border), 0.55);
				border-radius: 1.2rem;
				background: rgba(var(--surface-elevated), 0.48);
			}
			.adjacent-label {
				margin: 0;
				font-size: 0.78rem;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: rgb(var(--gray));
			}
			.adjacent-card h2 {
				margin: 0;
				font-size: 1.2rem;
				line-height: 1.12;
			}
			.adjacent-card p {
				margin: 0;
				color: rgb(var(--gray-dark));
			}
			.adjacent-card:hover {
				border-color: rgba(var(--black), 0.08);
				background: rgba(var(--surface-elevated), 0.72);
			}
			.adjacent-empty {
				display: none;
			}
			@media (max-width: 720px) {
				main {
					width: calc(100% - 1.3rem);
				}
				main.has-toc {
					width: calc(100% - 1.3rem);
				}
				.adjacent-grid {
					grid-template-columns: 1fr;
				}
				.meta {
					flex-direction: column;
					align-items: start;
					gap: 0.3rem;
				}
			}
			@media (max-width: 980px) {
				.article-body.has-toc {
					grid-template-columns: 1fr;
					gap: 1.4rem;
				}
				.article-main {
					width: min(42rem, 100%);
				}
				.table-of-contents {
					position: static;
					top: auto;
					order: -1;
					max-height: none;
					overflow: visible;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main class:list={{ 'has-toc': hasTableOfContents }}>
			<article class="story">
				<a class="back-link" href="/blog">Back to archive</a>
				<header class="article-header">
					<div class="kicker">
						<span>Note</span>
					</div>
					<div class="meta">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<div class="last-updated-on">
									Updated <FormattedDate date={updatedDate} />
								</div>
							)
						}
					</div>
					<div class="title">
						<h1>{title}</h1>
					</div>
					<p class="deck">{description}</p>
				</header>
				{heroImage && (
					<div class="hero-image">
						<Image width={1200} height={675} src={heroImage} alt="" />
					</div>
				)}
				<div class:list={['article-body', hasTableOfContents && 'has-toc']}>
					<div class="article-main">
						<div class="prose">
							<slot />
						</div>
						<section class="article-footer" aria-label="Adjacent notes">
							<div class="adjacent-grid">
								{
									newerPost ? (
										<a class="adjacent-card" href={`/blog/${newerPost.id}/`}>
											<p class="adjacent-label">Newer note</p>
											<h2>{newerPost.data.title}</h2>
											<p>{newerPost.data.description}</p>
										</a>
									) : (
										<div class="adjacent-empty"></div>
									)
								}
								{
									olderPost ? (
										<a class="adjacent-card" href={`/blog/${olderPost.id}/`}>
											<p class="adjacent-label">Older note</p>
											<h2>{olderPost.data.title}</h2>
											<p>{olderPost.data.description}</p>
										</a>
									) : (
										<div class="adjacent-empty"></div>
									)
								}
							</div>
						</section>
					</div>
					{
						hasTableOfContents && (
							<aside class="table-of-contents" aria-label="Table of contents">
								<p class="toc-label">On this page</p>
								<ol class="toc-list">
									{tableOfContents.map((heading) => (
										<li class:list={['toc-item', `depth-${heading.depth}`]}>
											<a
												class="toc-link"
												data-toc-link
												href={`#${heading.slug}`}
											>
												{heading.text}
											</a>
										</li>
									))}
								</ol>
							</aside>
						)
					}
				</div>
			</article>
		</main>
		<Footer />
		{
			hasTableOfContents && (
				<script is:inline>
					const tocLinks = Array.from(document.querySelectorAll('[data-toc-link]'));
					const sections = tocLinks
						.map((link) => {
							const id = decodeURIComponent(link.hash.slice(1));
							return document.getElementById(id);
						})
						.filter(Boolean);

					if (tocLinks.length > 0 && sections.length > 0) {
						const setActiveLink = (id) => {
							for (const link of tocLinks) {
								link.classList.toggle('is-active', decodeURIComponent(link.hash.slice(1)) === id);
							}
						};

						const observer = new IntersectionObserver(
							(entries) => {
								const visibleEntries = entries
									.filter((entry) => entry.isIntersecting)
									.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

								if (visibleEntries.length > 0) {
									setActiveLink(visibleEntries[0].target.id);
								}
							},
							{
								rootMargin: '-100px 0px -55% 0px',
								threshold: [0, 1],
							},
						);

						for (const section of sections) {
							observer.observe(section);
						}

						const initialHash = decodeURIComponent(window.location.hash.slice(1));
						if (initialHash) {
							setActiveLink(initialHash);
						} else {
							setActiveLink(sections[0].id);
						}
					}
				</script>
			)
		}
	</body>
</html>
