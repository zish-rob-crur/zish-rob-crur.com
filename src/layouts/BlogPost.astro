---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

interface Props extends CollectionEntry<'blog'>['data'] {
	newerPost?: CollectionEntry<'blog'> | null;
	olderPost?: CollectionEntry<'blog'> | null;
}

const { title, description, pubDate, updatedDate, heroImage, newerPost = null, olderPost = null } =
	Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
		<style>
			main {
				width: min(860px, calc(100% - 2rem));
				max-width: none;
			}
			.story {
				display: grid;
				gap: 2rem;
			}
			.back-link,
			.adjacent-card {
				width: fit-content;
				text-decoration: none;
			}
			.back-link {
				font-size: 0.88rem;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: rgb(var(--gray));
			}
			.article-header {
				display: grid;
				gap: 0.85rem;
				padding-bottom: 1.8rem;
				border-bottom: 1px solid rgba(var(--border), 0.58);
			}
			.meta,
			.kicker {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.7rem;
				font-size: 0.9rem;
				color: rgb(var(--gray));
			}
			.kicker {
				letter-spacing: 0.14em;
				text-transform: uppercase;
				font-size: 0.78rem;
			}
			.title {
				margin: 0;
			}
			.title h1 {
				margin: 0;
				font-size: clamp(2.8rem, 7vw, 5rem);
				line-height: 0.98;
			}
			.deck {
				max-width: 42rem;
				margin: 0;
				font-size: 1.14rem;
				line-height: 1.8;
			}
			.hero-image img {
				display: block;
				width: 100%;
				border-radius: 20px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: min(42rem, 100%);
				max-width: none;
				margin: 0;
				padding: 0;
				color: rgb(var(--gray-dark));
			}
			.prose > :first-child {
				margin-top: 0;
			}
			.prose :where(h2, h3, h4) {
				margin-top: 2.1rem;
				margin-bottom: 0.7rem;
			}
			.prose :where(ul, ol) {
				padding-left: 1.35rem;
			}
			.last-updated-on {
				font-style: italic;
			}
			.article-footer {
				display: grid;
				gap: 1rem;
				padding-top: 1.5rem;
				border-top: 1px solid rgba(var(--border), 0.58);
			}
			.adjacent-grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1rem;
			}
			.adjacent-card {
				display: grid;
				gap: 0.4rem;
				min-height: 7.4rem;
				padding: 1rem 1.1rem;
				border: 1px solid rgba(var(--border), 0.55);
				border-radius: 1.2rem;
				background: rgba(var(--surface-elevated), 0.48);
			}
			.adjacent-label {
				margin: 0;
				font-size: 0.78rem;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: rgb(var(--gray));
			}
			.adjacent-card h2 {
				margin: 0;
				font-size: 1.2rem;
				line-height: 1.12;
			}
			.adjacent-card p {
				margin: 0;
				color: rgb(var(--gray-dark));
			}
			.adjacent-card:hover {
				border-color: rgba(var(--black), 0.08);
				background: rgba(var(--surface-elevated), 0.72);
			}
			.adjacent-empty {
				display: none;
			}
			@media (max-width: 720px) {
				main {
					width: calc(100% - 1.3rem);
				}
				.adjacent-grid {
					grid-template-columns: 1fr;
				}
				.meta {
					flex-direction: column;
					align-items: start;
					gap: 0.3rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article class="story">
				<a class="back-link" href="/blog">Back to archive</a>
				<header class="article-header">
					<div class="kicker">
						<span>Note</span>
					</div>
					<div class="meta">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<div class="last-updated-on">
									Updated <FormattedDate date={updatedDate} />
								</div>
							)
						}
					</div>
					<div class="title">
						<h1>{title}</h1>
					</div>
					<p class="deck">{description}</p>
				</header>
				{heroImage && (
					<div class="hero-image">
						<Image width={1200} height={675} src={heroImage} alt="" />
					</div>
				)}
				<div class="prose">
					<slot />
				</div>
				<section class="article-footer" aria-label="Adjacent notes">
					<div class="adjacent-grid">
						{
							newerPost ? (
								<a class="adjacent-card" href={`/blog/${newerPost.id}/`}>
									<p class="adjacent-label">Newer note</p>
									<h2>{newerPost.data.title}</h2>
									<p>{newerPost.data.description}</p>
								</a>
							) : (
								<div class="adjacent-empty"></div>
							)
						}
						{
							olderPost ? (
								<a class="adjacent-card" href={`/blog/${olderPost.id}/`}>
									<p class="adjacent-label">Older note</p>
									<h2>{olderPost.data.title}</h2>
									<p>{olderPost.data.description}</p>
								</a>
							) : (
								<div class="adjacent-empty"></div>
							)
						}
					</div>
				</section>
			</article>
		</main>
		<Footer />
	</body>
</html>
