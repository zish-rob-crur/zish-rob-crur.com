---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav class="frame">
		<div class="brand">
			<a href="/" class="brand-mark">{SITE_TITLE}</a>
			<p>Software, tools, and the defaults worth keeping.</p>
		</div>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		margin: 0;
		padding: 0 1.25rem;
		border-bottom: 1px solid rgba(var(--border), 0.5);
		background: rgba(var(--surface), 0.76);
		backdrop-filter: blur(20px);
	}
	.frame {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 1rem 1.25rem;
		align-items: center;
		width: min(1100px, calc(100% - 0.5rem));
		margin: 0 auto;
		padding: 1rem 0;
	}
	.brand {
		display: grid;
		gap: 0.15rem;
	}
	.brand-mark,
	.brand-mark.active {
		font-family: var(--font-display);
		font-size: 1.15rem;
		letter-spacing: 0.04em;
		text-decoration: none;
	}
	.brand p {
		margin: 0;
		font-size: 0.8rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: rgb(var(--gray));
	}
	.internal-links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem;
	}
	.frame a {
		padding: 0.45rem 0.75rem;
		border-radius: 999px;
		color: rgb(var(--black));
		text-decoration: none;
		transition:
			background-color 180ms ease,
			color 180ms ease,
			transform 180ms ease;
	}
	.frame a:hover,
	.frame a:focus-visible {
		background: rgba(var(--gray-soft), 0.6);
		transform: translateY(-1px);
	}
	.frame a.active {
		background: rgba(var(--gray-soft), 0.72);
		color: var(--accent);
	}
	@media (max-width: 860px) {
		.frame {
			grid-template-columns: 1fr;
		}
		.brand p {
			display: none;
		}
		.internal-links {
			justify-content: space-between;
		}
	}
	@media (max-width: 560px) {
		header {
			padding: 0 0.9rem;
		}
		.frame {
			padding: 0.8rem 0;
			gap: 0.7rem;
		}
		.internal-links,
		.social-links {
			gap: 0.15rem;
		}
		.frame a {
			padding: 0.4rem 0.55rem;
		}
	}
</style>
