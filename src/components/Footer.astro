---
const today = new Date();
---

<footer>
	<div class="frame">
		<div class="signature">
			<p class="name">zishRobCrur</p>
			<p class="note">Quiet, clear, and built for the long run.</p>
		</div>
		<div class="meta">
			<p>&copy; {today.getFullYear()} zishRobCrur</p>
			<div class="social-links">
				<a href="mailto:me@zish-rob-crur.com" rel="me">Email</a>
				<a href="https://github.com/zish-rob-crur" target="_blank" rel="me noreferrer">GitHub</a>
				<a href="https://x.com/zDAKVp9Nh6k1wj" target="_blank" rel="me noreferrer">X</a>
				<a href="/nucleus/privacy">Nucleus Privacy</a>
				<a href="/rss.xml">RSS</a>
			</div>
		</div>
	</div>
</footer>
<style>
	footer {
		padding: 0 1.25rem 4rem;
		color: rgb(var(--gray));
	}
	.frame {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem 2rem;
		width: min(1100px, calc(100% - 0.5rem));
		margin: 0 auto;
		padding-top: 2.4rem;
		border-top: 1px solid rgba(var(--border), 0.5);
	}
	.name,
	.meta p {
		margin: 0;
	}
	.name {
		font-family: var(--font-display);
		font-size: 1.05rem;
		color: rgb(var(--black));
	}
	.note {
		margin: 0.3rem 0 0;
	}
	.meta {
		display: grid;
		gap: 0.45rem;
		justify-items: end;
	}
	.social-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: end;
		gap: 0.9rem;
	}
	.social-links a {
		text-decoration: none;
		color: rgba(var(--gray), 0.9);
		font-size: 0.82rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.social-links a:hover {
		color: var(--accent);
	}
	@media (max-width: 720px) {
		footer {
			padding: 0 0.9rem 3rem;
		}
		.frame,
		.meta {
			justify-items: start;
		}
		.frame {
			flex-direction: column;
			align-items: start;
			padding-top: 2rem;
		}
		.social-links {
			justify-content: start;
		}
	}
</style>
